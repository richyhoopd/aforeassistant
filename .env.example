# Envío del resultado de la calculadora por correo (Resend). Sin RESEND_API_KEY
# el endpoint /api/resultado responde 503 y el formulario muestra el error.
RESEND_API_KEY=
# Remitente verificado en Resend (dominio pensionmas.com.mx)
RESULT_FROM="Pensión+ <resultados@pensionmas.com.mx>"
# Opcional: buzón que recibe copia de cada resultado enviado (el lead)
RESULT_BCC=
