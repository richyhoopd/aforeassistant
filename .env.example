# Supabase (local: valores de `supabase start`; prod: dashboard del proyecto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Cloud API (false hasta que Meta apruebe el negocio)
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_WELCOME=bienvenida_pensionmas

# Sal para hashear códigos OTP (generar: openssl rand -hex 32)
OTP_PEPPER=

# Cron de seguimientos (generar: openssl rand -hex 32)
CRON_SECRET=

# Webhook de WhatsApp (token que tú inventas y pegas igual en Meta)
WHATSAPP_VERIFY_TOKEN=

# App Secret de la app de Meta — obligatorio en producción para validar la firma del webhook
WHATSAPP_APP_SECRET=

# Plantillas de recordatorios del cron (defaults si se dejan vacías)
# WHATSAPP_TEMPLATE_NSS=recordatorio_nss
# WHATSAPP_TEMPLATE_FIRMA=recordatorio_firma
# WHATSAPP_TEMPLATE_CALIFICAS=ya_calificas_pensionmas
# WHATSAPP_TEMPLATE_OTP=codigo_pensionmas
# WHATSAPP_TEMPLATE_CONTINUA=continuar_pensionmas

# Revisión del caso antes de la firma
# WHATSAPP_TEMPLATE_REVISANDO=revision_iniciada_pensionmas
# WHATSAPP_TEMPLATE_REVISADO=contrato_listo_pensionmas
# Nombre que firma los mensajes y aparece en la página de firma
# ADVISOR_NAME=Ricardo
# Honorarios como porcentaje del depósito real
# COMMISSION_PCT=10
# Minutos entre "estamos revisando tu caso" y el envío del contrato
# REVIEW_DELAY_MINUTES=60
# Ventana horaria de envío (hora de CDMX); fuera de ella el contrato espera
# PIPELINE_HORA_INICIO=8
# PIPELINE_HORA_FIN=21
# Foto del asesor (opcional; sin ella se muestran sus iniciales)
# ADVISOR_PHOTO_URL=
